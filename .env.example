# Harness2 configuration template
# Copy to .env and fill in the settings for the benchmarks and substrates you run.
# Shell environment variables take precedence over .env.

# --- Vertex AI & OpenCode / Codex benchmarks (lab, jb, wb) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Executor and improver models in OpenCode's provider/model syntax
HARNESS2_SOLVER_MODEL=
HARNESS2_IMPROVER_MODEL=

# Bare judge model ID (e.g. gemini-2.5-pro); the adapter supplies the provider prefix
HARNESS2_JUDGE_MODEL=

# Optional separate judge endpoint (JobBench)
# HARNESS2_JUDGE_BASE_URL=
# HARNESS2_JUDGE_API_KEY=

# Optional Codex executor settings (populated by harness2-bridge or set directly)
# HARNESS2_CODEX_BASE_URL=
# HARNESS2_CODEX_CONTAINER_URL=
# HARNESS2_CODEX_API_KEY=
# HARNESS2_CODEX_MODEL=

# Output directory for runs (defaults to ./runs)
HARNESS2_RUNS_DIR=runs

# --- AGY substrate & skillbench (--bench skillbench --substrate agy) ---
# Executable name or path for AGY. Google-internal Jetski: HARNESS2_AGY_BIN=/google/bin/releases/jetski-devs/tools/cli
# (a shell alias or function such as `jet` cannot be used)
HARNESS2_AGY_BIN=agy

# Path to the cc-thingz plugins/ directory (required for skillbench)
SKILLBENCH_PLUGINS_DIR=~/projects/cc-thingz/plugins

# Comma-separated allowlist of cc-thingz plugins staged into each rollout's HOME
SKILLBENCH_PLUGINS=brainstorm,planning,review,skill-eval,thinking-tools,workflow

# Optional comma-separated credential files relative to $HOME copied (never symlinked) into each
# rollout's HOME; empty copies nothing (internal Jetski needs no auth files)
SKILLBENCH_AUTH_FILES=

# Executor and judge model ids passed to `agy --model` (see `jet models`; the id pins the effort)
SKILLBENCH_EXEC_MODEL=opus-5.5-high
SKILLBENCH_JUDGE_MODEL=fable-5.1-high

# Optional extra `agy --effort` (low|medium|high|xhigh|max) for both arms and the judge; empty passes
# no --effort because the model id already pins it
SKILLBENCH_EFFORT=

# Number of repeated judge calls per rollout (default 1; pilot mode sets 2 to measure judge noise)
SKILLBENCH_JUDGE_REPEAT=1

# Set to 1 to restrict skillbench runs and reports to pilot=true tasks
SKILLBENCH_PILOT=0
